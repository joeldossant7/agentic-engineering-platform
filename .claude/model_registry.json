{
  "version": "2.0",
  "description": "Hybrid multi-provider model registry for agentic systems. Supports cloud APIs, local Ollama runtimes, and HuggingFace transformers with plug-and-play routing.",
  "default_routing": {
    "reasoning": "claude-opus-4-7",
    "coding": "claude-sonnet-4-6",
    "fast_tasks": "claude-haiku-4-5-20251001",
    "local_general": "llama-3.1-70b-instruct",
    "local_coding": "deepseek-coder-v2",
    "vision": "gpt-4o",
    "cheap_reasoning": "qwen-2.5-72b-instruct"
  },
  "aliases": {
    "claude-opus-latest": "claude-opus-4-7",
    "claude-sonnet-latest": "claude-sonnet-4-6",
    "claude-haiku-latest": "claude-haiku-4-5-20251001",
    "local-best": "llama-3.1-70b-instruct",
    "local-code": "deepseek-coder-v2",
    "cheap-reasoner": "qwen-2.5-72b-instruct"
  },
  "providers": {
    "anthropic": {
      "type": "cloud_api",
      "base_url": "https://api.anthropic.com/v1",
      "supports_tools": true,
      "supports_streaming": true
    },
    "openai": {
      "type": "cloud_api",
      "base_url": "https://api.openai.com/v1",
      "supports_tools": true,
      "supports_streaming": true
    },
    "ollama": {
      "type": "local_runtime",
      "base_url": "http://localhost:11434",
      "supports_tools": false,
      "supports_streaming": true
    },
    "huggingface": {
      "type": "local_transformers",
      "device": "cuda",
      "quantization": "4bit",
      "supports_tools": false
    }
  },
  "models": {
    "claude-opus-4-7": {
      "provider": "anthropic",
      "deployment_type": "cloud",
      "family": "opus",
      "vendor_family": "claude",
      "version": "4.7",
      "api_model_id": "claude-opus-4-7",
      "context_window": 200000,
      "max_output_tokens": 32000,
      "supports_thinking": true,
      "supports_vision": true,
      "supports_function_calling": true,
      "capabilities": [
        "reasoning",
        "systems_design",
        "architecture",
        "code",
        "vision",
        "extended_thinking"
      ],
      "cost_tier": "very_high",
      "latency_tier": "medium",
      "recommended_for": [
        "po_agent",
        "planner_agent",
        "research_agent",
        "architecture_reviews"
      ],
      "temperature_profile": {
        "default": 0.4,
        "creative": 0.8,
        "strict": 0.1
      },
      "policy_ref": "C-08"
    },

    "claude-sonnet-4-6": {
      "provider": "anthropic",
      "deployment_type": "cloud",
