  "routing_policies": {
    "fallback_order": [
      "claude-sonnet-4-6",
      "qwen-2.5-72b-instruct",
      "llama-3.1-70b-instruct"
    ],

    "cost_optimization": {
      "prefer_local_under_load": true,
      "max_cloud_cost_tier": "high"
    },

    "vision_tasks": {
      "primary": "gpt-4o",
      "fallback": "claude-sonnet-4-6"
    },

    "coding_tasks": {
      "primary": "claude-sonnet-4-6",
      "secondary": "deepseek-coder-v2",
      "offline_fallback": "qwen-2.5-72b-instruct"
    }
  }
